# Salin menjadi .env (jangan di-commit). Dibaca oleh backend/ dan alat bantu.

# --- Ruang ---
ROOM_ID=gd525
ROOM_LABEL=GD 525

# --- MQTT ---
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=co2class

# --- Backend ---
# DB_PATH=backend/data/co2class.db
# persistence = cadangan sesuai docs, linear = demo dashboard, gru = setelah model dari ml/ siap
PREDICTOR=persistence
# MODEL_PATH=ml/models/gru.pt
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Ambang CO2 (ppm) ---
TH_WATCH=800
TH_HIGH=1000
TH_CRITICAL=1500

# --- Frontend (frontend/.env.local) ---
# NEXT_PUBLIC_API_URL=http://localhost:8000
